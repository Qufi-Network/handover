# Copy to .env. Everything is optional: without a client ID the app shows a setup screen.

PORT=4960
# Must match the origin registered in the Veyns console exactly.
PUBLIC_ORIGIN=http://localhost:4960

VEYNS_ISSUER=https://sandbox.id.veyns.io
# From the Veyns developer console (or paste it into the app's setup screen).
VEYNS_CLIENT_ID=
# Backend credential from the console. Enables palm approvals. Never put this in the browser.
VEYNS_BACKEND_SECRET=

# Optional locally: a Postgres URL. Without it, data lives in data/pgdata (PGlite).
DATABASE_URL=

# How long the receiver has to accept (seconds). Use 120 to try recall quickly.
HOLD_SECONDS=86400
# Extra time after the window before recall opens, so an approval finished in time can still land.
GRACE_SECONDS=300
STARTING_CREDITS=1000
